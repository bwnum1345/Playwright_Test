{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@playwright/test": ["./node_modules/@playwright/test"]
    }
  },
  "include": ["**/*.ts", "../pages/**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
